# Thermaltrue WMS — Environment Variables
# Copy this file to .env and adjust values for your environment

# ── Server ──
APP_MODE=production
PORT=3000
# WARNING: empty or '*' allows ANY origin (permissive mode). Set to specific URL for production.
# Examples: http://localhost:3000, https://app.thermaltrue.com
CORS_ORIGIN=
JWT_SECRET=change-this-to-a-random-64-char-string
SESSION_TTL_HOURS=24
# Use sslmode=require for non-local or cloud databases
DATABASE_URL=postgresql://postgres:password@localhost:5432/thermaltrue?sslmode=disable
DATABASE_POOL_SIZE=10

# ── Server.exe static frontend (optional) ──
# Path to compiled frontend dist/; defaults to "../dist" relative to server.exe
# FRONTEND_DIST=/opt/thermaltrue/dist

# ── Logging ──
# RUST_LOG=info

# ── Default Admin ──
# Used only on first run when no users exist; auto-generated if not set.
# IMPORTANT: Set a strong password before go-live so it's not auto-generated.
# DEFAULT_ADMIN_PASSWORD=MyS3cur3P@ss

# ── Tauri / Client ──
VITE_APP_TITLE=Thermaltrue WMS
VITE_TAURI_DEV_HOST=localhost
VITE_API_URL=http://localhost:3000
VITE_FORCE_HTTP=true

# ── Updater (optional) ──
# TAURI_PUBLIC_KEY=

# ── Backup (optional) ──
# Directory for auto-backup dumps; defaults to "./backups"
# BACKUP_DIR=C:\ProgramData\Thermaltrue\backups
# Auto-backup interval in hours; defaults to 24
# BACKUP_INTERVAL_HOURS=24

# ── TLS / HTTPS (optional) ──
# Set both to enable HTTPS; leave empty for HTTP
# TLS_CERT_PATH=C:\path\to\cert.pem
# TLS_KEY_PATH=C:\path\to\key.pem

# ── Error Tracking (optional) ──
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
