{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Client capability - remote server",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "updater:allow-download-and-install",
    "notification:default",
    "process:default",
    "barcode-scanner:default",
    "log:default",
    "mcp-bridge:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
