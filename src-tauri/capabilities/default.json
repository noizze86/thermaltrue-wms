{
  "$schema": "../gen/schemas/desktop-schema.json",
"identifier": "default",
  "description": "Production capability - localhost + LAN IP",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:3000/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:5174/*",
      "http://localhost:5174/*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "updater:allow-download-and-install",
    "notification:default",
    "process:default",
    "barcode-scanner:default",
    "log:default",
    "mcp-bridge:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3000" },
        { "url": "http://localhost:3001" },
        { "url": "http://localhost:3002" },
        { "url": "http://*:8000/**" },
        { "url": "https://localhost:3443" },
        { "url": "https://*:443/**" },
        { "url": "https://*:8443/**" },
        { "url": "https://*:**" }
      ]
    }
  ]
}
